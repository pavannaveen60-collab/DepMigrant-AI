# Environment Variables Template
# Copy to .env and fill in your values

# Nebius AI Studio (for NVIDIA Nemotron)
# Configure one provider. Nebius takes precedence if both keys are set.
# NEBIUS_API_KEY=your_nebius_api_key_here
NEBIUS_BASE_URL=https://api.studio.nebius.com/v1
NEBIUS_MODEL=nvidia/nemotron-3-ultra

# Alternative: Direct NVIDIA NIM (if using NVIDIA NIM endpoints)
# NVIDIA_NIM_API_KEY=your_nvidia_nim_key
# NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
# NVIDIA_NIM_MODEL=nvidia/nemotron-3-ultra

# Backend
API_HOST=127.0.0.1
API_PORT=8000
API_WORKERS=1

# Frontend
# Used by the Next.js server-side API rewrites; browser requests stay same-origin.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Sandbox/Execution
SANDBOX_TIMEOUT=300
SANDBOX_MAX_MEMORY_MB=2048
SANDBOX_MAX_CPU_PERCENT=80
# Repository command execution is disabled unless explicitly enabled.
ALLOW_UNSAFE_REPOSITORY_EXECUTION=false

# Database
# Optional override. Without it, local development uses the home-directory DB;
# Render uses /tmp/depmigrant.db (ephemeral).
# DATABASE_URL=sqlite:///./depmigrant.db

# Logging
LOG_LEVEL=INFO